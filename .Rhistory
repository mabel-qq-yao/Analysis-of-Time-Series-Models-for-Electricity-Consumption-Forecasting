# Box-Pierce test and Ljung-Box test
Box.test(fit.model1$residuals, lag=40, fitdf=2)
Box.test(fit.model1$residuals, lag=40, fitdf=1)
Box.test(fit.model1$residuals, lag=40, fitdf=0)
acf(fit.model1$residuals, lag.max=40)
rho.hat <- acf(fit.model1$residuals, lag.max=40, plot=F)$acf[-1]
n <- length(fit.model1$residuals)
h <- length(rho.hat)
q <- n*(n+2)*sum(rho.hat^2/(n-(1:h)))
q
pchisq(q, df=h, lower=F)
qqnorm(fit.model1$residuals)
hist(fit.model1$residuals)
trend <- time(OT)
hufl <- HUFL - mean(HUFL)
hull <- HULL - mean(HULL)
mufl <- MUFL - mean(MUFL)
mull <- MULL - mean(MULL)
lufl <- LUFL - mean(LUFL)
lull <- LULL - mean(LULL)
lufl2 <- lufl^2
lull2 <- lull^2
fit.model2 <- lm(OT ~ trend + hufl + hull + mufl + mull + (lufl +lufl2) + (lull +lull2))
summary(fit.model2)
anova(fit.model2)
plot(OT, type="line")
lines(fit.model2$fitted.values, lty=2, col="blue")
num <- length(OT)
# AIC
AIC(fit.model2)/num - log(2*pi)
# BIC
AIC(fit.model2, k=log(num))/num - log(2*pi)
# AICc
log(sum(resid(fit.model2)^2)/num) + (num +5)/(num -5 -2)
# Box-Pierce test and Ljung-Box test
Box.test(fit.model2$residuals, lag=40, fitdf=2)
Box.test(fit.model2$residuals, lag=40, fitdf=1)
Box.test(fit.model2$residuals, lag=40, fitdf=0)
qqnorm(fit.model2$residuals)
hist(fit.model2$residuals)
